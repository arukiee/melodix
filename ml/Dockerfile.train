FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace
ENV PYTHONPATH=/workspace
COPY ml/requirements.lock /workspace/ml/requirements.lock
RUN pip install --no-cache-dir -r /workspace/ml/requirements.lock
COPY ml /workspace/ml

CMD ["python", "ml/training/train_transcription.py", "--smoke", "--config", "ml/configs/transcription.yaml", "--device", "cpu"]
